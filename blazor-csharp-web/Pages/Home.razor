@page "/"
@inject IJSRuntime JSRuntime
@using System.Numerics
@using System.Collections.Generic
@using blazor_csharp_web.Models
@implements IDisposable

<div id="canvas-wrapper" style="width: 100vw; height: 100vh; background: #1a1a1a; position: fixed; top: 0; left: 0; z-index: 1;">
    <canvas id="main-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
    
    <div id="ui-overlay" style="position: absolute; top: 20px; left: 20px; color: white; background: rgba(0,0,0,0.7); padding: 20px; border-radius: 12px; z-index: 10; pointer-events: auto; border: 1px solid #444; font-family: sans-serif;">
        <div style="font-weight: bold; margin-bottom: 15px; border-bottom: 1px solid #444; padding-bottom: 5px;">MODELME C# CORE</div>
        
        <label style="font-size: 12px; color: #aaa;">HEIGHT</label><br/>
        <input type="range" @bind="Height" @bind:event="oninput" min="0" max="1" step="0.01" style="width: 200px; margin-bottom: 10px;" /><br/>
        
        <label style="font-size: 12px; color: #aaa;">WEIGHT</label><br/>
        <input type="range" @bind="Weight" @bind:event="oninput" min="0" max="1" step="0.01" style="width: 200px; margin-bottom: 10px;" /><br/>
        
        <label style="font-size: 12px; color: #aaa;">WAIST</label><br/>
        <input type="range" @bind="Waist" @bind:event="oninput" min="0" max="1" step="0.01" style="width: 200px;" />
        
        <div id="debug-status" style="margin-top: 15px; font-size: 11px; color: #0f0;">
            Status: Initializing...
        </div>
    </div>
</div>

@code {
    private double _height = 0.5;
    private double _weight = 0.5;
    private double _waist = 0.5;

    public double Height { get => _height; set { _height = value; UpdateSimulation(); } }
    public double Weight { get => _weight; set { _weight = value; UpdateSimulation(); } }
    public double Waist { get => _waist; set { _waist = value; UpdateSimulation(); } }

    private DotNetObjectReference<Home>? objRef;
    private TshirtDynamics? dynamics;
    private MannequinController mannequinController = new();

    protected override void OnInitialized()
    {
        dynamics = new TshirtDynamics(new ClothConfiguration());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            // Small delay to ensure DOM is ready
            await Task.Delay(500);
            await JSRuntime.InvokeVoidAsync("initThreeJS", objRef);
            UpdateSimulation();
        }
    }

    [JSInvokable]
    public void OnModelLoaded()
    {
        mannequinController.OnModelLoaded();
    }

    private async void UpdateSimulation()
    {
        await JSRuntime.InvokeVoidAsync("updateBodyParams", _height, _weight, _waist);
    }

    [JSInvokable]
    public void InitializeCloth(float[] positions, int[] indices)
    {
        dynamics?.InitializeFromMesh(positions, indices);
    }

    [JSInvokable]
    public void StepSimulation(float dt)
    {
        if (dynamics == null || dynamics.Particles.Count == 0) return;
        
        dynamics.Update(dt, _height, _weight, _waist);
        
        var jsInProcess = (IJSInProcessRuntime)JSRuntime;
        jsInProcess.InvokeVoid("updateMeshAttributes", dynamics.VertexPositions, dynamics.VertexColors);
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
